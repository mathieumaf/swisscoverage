---
import { api, serverApiUrl } from "../../api/server";
import { formatDate, formatNumber, isLocale } from "../../i18n/locales";
import { translate } from "../../i18n/translate";
import Base from "../../layouts/Base.astro";
import StationMap from "../../map/StationMap";

const { lang } = Astro.params;
if (!isLocale(lang)) {
  return Astro.rewrite("/404");
}
const locale = lang;

// The API's origin, which the map calls from the browser. When it is not
// usable, the page renders without the map and says the data cannot be
// loaded; the reason goes to the log.
let browserApiUrl: string | undefined;
try {
  browserApiUrl = serverApiUrl();
} catch (cause) {
  console.error("SWISSCOVERAGE_API_URL is not usable:", cause);
}

// The latest snapshot, read from the public API, so that the page says what
// it shows before the map has loaded, and without JavaScript. When the API
// does not answer, the page still renders and says so; the reason goes to the
// log.
let snapshot: string;
try {
  const { data, response } = await api().GET("/v1/stations/counts");
  if (data === undefined) {
    throw new Error(`The API answered ${response.status}`);
  }
  snapshot = translate(locale, "home.snapshot", {
    count: formatNumber(locale, data.stations),
    date: formatDate(locale, new Date(data.snapshot.publishedAt)),
  });
} catch (cause) {
  console.error("Reading the station counts from the API failed:", cause);
  snapshot = translate(locale, "home.unavailable");
}
---

<Base locale={locale} fullscreen>
  {browserApiUrl && (
    <StationMap client:only="react" locale={locale} apiUrl={browserApiUrl} />
  )}
  <section
    class="pointer-events-none absolute top-3 left-3 max-w-[min(22rem,calc(100%-5rem))] rounded-xl border border-border bg-background px-4 py-3 shadow-[0_2px_8px_rgb(0_0_0/0.15)]"
  >
    <h1 class="text-[1.0625rem] leading-[1.3] font-bold">
      {translate(locale, "home.title")}
    </h1>
    {/* On a phone the map comes first: the panel keeps the title and the date. */}
    <p class="mt-1 text-[0.875rem] phone:hidden">
      {translate(locale, "home.intro")}
    </p>
    <p id="snapshot" class="mt-1 text-[0.875rem] text-muted">{snapshot}</p>
    <noscript>
      <p class="mt-1 text-[0.875rem]">{translate(locale, "map.noScript")}</p>
    </noscript>
    {/* OFCOM's credit, rendered by the server, so that it shows with the data
        even when the map cannot load. */}
    <p class="mt-1 text-[0.75rem] text-muted">
      {translate(locale, "footer.source")}{" · "}
      <a class="pointer-events-auto" href="https://github.com/mathieumaf/swisscoverage"
        >{translate(locale, "footer.code")}</a
      >
    </p>
  </section>
</Base>
