---
import { api, serverApiUrl } from "../../api/server";
import { formatDate, formatNumber, isLocale } from "../../i18n/locales";
import { translate } from "../../i18n/translate";
import Base from "../../layouts/Base.astro";
import Logo from "../../layouts/Logo.astro";
import { operators } from "../../map/filters";
import StationMap from "../../map/StationMap";
import { operatorColors } from "../../map/stations";

const { lang } = Astro.params;
if (!isLocale(lang)) {
  return Astro.rewrite("/404");
}
const locale = lang;

// The API's origin, which the map calls from the browser. When it is not
// usable, the page renders without the map and says the data cannot be
// loaded; the reason goes to the log.
let browserApiUrl: string | undefined;
try {
  browserApiUrl = serverApiUrl();
} catch (cause) {
  console.error("SWISSCOVERAGE_API_URL is not usable:", cause);
}

// The latest snapshot, read from the public API, so that the page says what
// it shows before the map has loaded, and without JavaScript. When the API
// does not answer, the page still renders and says so; the reason goes to the
// log.
let snapshot: string;
try {
  const { data, response } = await api().GET("/v1/stations/counts");
  if (data === undefined) {
    throw new Error(`The API answered ${response.status}`);
  }
  snapshot = translate(locale, "home.snapshot", {
    count: formatNumber(locale, data.stations),
    date: formatDate(locale, new Date(data.snapshot.publishedAt)),
  });
} catch (cause) {
  console.error("Reading the station counts from the API failed:", cause);
  snapshot = translate(locale, "home.unavailable");
}
---

<Base
  locale={locale}
  description={translate(locale, "home.intro")}
  fullscreen
>
  {browserApiUrl && (
    <StationMap client:only="react" locale={locale} apiUrl={browserApiUrl} />
  )}
  {/* The panel of the map: at the top left of a large screen, at the bottom
      of a phone. Its home, rendered here, shows without JavaScript and stays
      small: the search, the site and the date of its data, the colours of the
      operators. The map adds the search at its top, and the panel grows to
      the height of the screen when it shows results, a station or the
      stations at one place. */}
  <aside
    id="map-panel"
    data-view="home"
    aria-label={translate(locale, "home.title")}
    class="group absolute top-3 bottom-3 left-3 z-[3] flex w-[24rem] max-w-[calc(100%-1.5rem)] flex-col overflow-hidden rounded-3xl bg-surface shadow-card data-[view=home]:bottom-auto phone:top-auto phone:right-0 phone:bottom-0 phone:left-0 phone:max-h-[min(62%,34rem)] phone:w-auto phone:max-w-none phone:rounded-b-none phone:pb-6 phone:data-[view=home]:bottom-0"
  >
    <div id="map-panel-search" class="flex-none px-3 pt-3 empty:hidden"></div>
    <div class="min-h-0 flex-1 overflow-y-auto">
      <section class="hidden px-4 pt-3.5 pb-4 group-data-[view=home]:block">
        <div class="flex items-start gap-3">
          <Logo size={40} />
          <div class="min-w-0">
            <p class="leading-tight font-extrabold">swisscoverage</p>
            <h1 class="text-[0.875rem] leading-snug font-semibold">
              {translate(locale, "home.title")}
            </h1>
            <p id="snapshot" class="mt-0.5 text-[0.8125rem] text-muted">{snapshot}</p>
          </div>
        </div>
        <noscript>
          <p class="mt-3 text-[0.875rem]">{translate(locale, "map.noScript")}</p>
        </noscript>
        <h2 class="sr-only">{translate(locale, "home.legend")}</h2>
        <ul class="mt-3 flex flex-wrap gap-1.5 text-[0.8125rem] font-semibold">
          {operators.map((operator) => (
            <li class="flex items-center gap-1.5 rounded-full bg-field py-1 pr-2.5 pl-2">
              <span
                class="size-2.5 flex-none rounded-full"
                style={{ background: operatorColors[operator] }}
              ></span>
              {translate(locale, `operator.${operator}`)}
            </li>
          ))}
        </ul>
        {/* OFCOM's credit, rendered by the server, so that it shows with the
            data even when the map cannot load. */}
        <p class="mt-3 text-[0.75rem] text-muted">
          {translate(locale, "footer.source")}{" · "}
          <a href="https://github.com/mathieumaf/swisscoverage"
            >{translate(locale, "footer.code")}</a
          >
        </p>
      </section>
      <div id="map-panel-view"></div>
    </div>
  </aside>
</Base>

<script>
  // Another language keeps what the address holds beyond its path: the map's
  // filters, its open station and its position, which the map writes there as
  // the visitor moves it. The link is brought up to date before it is
  // followed, opened in a new tab, or copied.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "a[data-keep-view]",
  )) {
    const update = () => {
      link.href = link.pathname + window.location.search + window.location.hash;
    };
    for (const event of ["click", "auxclick", "contextmenu"]) {
      link.addEventListener(event, update);
    }
  }
</script>
