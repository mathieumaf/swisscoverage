---
import { isLocale, negotiateLocale } from "../i18n/locales";
import { translate } from "../i18n/translate";
import Base from "../layouts/Base.astro";

// In the language of the address when it names one, otherwise in the one the
// browser asks for. A page that found nothing rewrites to this one: the
// address it was asked for is the origin path.
const first = Astro.originPathname.split("/")[1];
const locale = isLocale(first)
  ? first
  : negotiateLocale(Astro.request.headers.get("Accept-Language"));
Astro.response.status = 404;
Astro.response.headers.set("Vary", "Accept-Language");
---

<Base locale={locale} title={translate(locale, "notFound.title")} error>
  <h1 class="my-[0.67em] text-[2em] font-bold">
    {translate(locale, "notFound.title")}
  </h1>
  <p class="my-[1em]">{translate(locale, "notFound.text")}</p>
  <p class="my-[1em]">
    <a href={`/${locale}/`}>{translate(locale, "notFound.home")}</a>
  </p>
</Base>
