---
import { isLocale, type Locale, locales, localizedPath } from "../i18n/locales";
import { languageNames, translate } from "../i18n/translate";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title?: string;
  // An error page has no translations: its language links lead to the home
  // page of each language.
  error?: boolean;
  // A page that fills the screen, such as the map, under the header and
  // without the footer. Its content must then credit OFCOM itself.
  fullscreen?: boolean;
}

const { locale, title, error = false, fullscreen = false } = Astro.props;
const t = (key: Parameters<typeof translate>[1]) => translate(locale, key);
const pageTitle = title ? `${title} · swisscoverage` : "swisscoverage";
const path = Astro.url.pathname;
const alternates = !error && isLocale(path.split("/")[1]) ? locales : [];
const linkTo = (other: Locale) =>
  error ? `/${other}/` : localizedPath(path, other);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t("site.description")} />
    <title>{pageTitle}</title>
    {alternates.map((other) => (
      <link rel="alternate" hreflang={other} href={localizedPath(path, other)} />
    ))}
  </head>
  <body
    class:list={[
      "flex min-h-dvh flex-col bg-background leading-normal text-foreground",
      fullscreen && "h-dvh overflow-hidden",
    ]}
  >
    <header
      class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-border px-4 py-3"
    >
      <a class="font-bold text-foreground no-underline" href={`/${locale}/`}
        >swisscoverage</a
      >
      <nav aria-label={t("nav.language")}>
        <ul class="flex gap-1">
          {locales.map((other) => (
            <li>
              <a
                class="inline-block min-w-11 rounded-md p-2 text-center text-[0.875rem] font-semibold text-muted no-underline aria-[current=page]:bg-border aria-[current=page]:text-foreground"
                href={linkTo(other)}
                hreflang={other}
                lang={other}
                aria-current={!error && other === locale ? "page" : undefined}
              >
                {other.toUpperCase()}
                <span class="sr-only"> {languageNames[other]}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main
      class:list={[
        "mx-auto w-full flex-1",
        fullscreen ? "relative" : "max-w-3xl px-4 py-8",
      ]}
    >
      <slot />
    </main>
    {!fullscreen && (
      <footer
        class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-border px-4 py-3 text-[0.875rem] text-muted"
      >
        <p>{t("footer.source")}</p>
        <p>
          <a href="https://github.com/mathieumaf/swisscoverage">{t("footer.code")}</a>{" · "}{t("footer.licence")}
        </p>
      </footer>
    )}
  </body>
</html>
