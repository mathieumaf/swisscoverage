---
import { isLocale, type Locale, locales, localizedPath } from "../i18n/locales";
import { translator } from "../i18n/translate";
import Logo from "./Logo.astro";
import SiteNav from "./SiteNav.astro";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title?: string;
  // What the page says, for search engines; the site's own by default.
  description?: string | undefined;
  // An error page has no translations: its language links lead to the home
  // page of each language.
  error?: boolean;
  // A page that fills the screen, such as the map, without the header and
  // the footer: the navigation floats over it. Its content must then credit
  // OFCOM itself.
  fullscreen?: boolean;
  // The header floats over the top of the content, such as the map at the
  // head of a station's page.
  overlay?: boolean;
}

const {
  locale,
  title,
  description,
  error = false,
  fullscreen = false,
  overlay = false,
} = Astro.props;
const t = translator(locale);
const pageTitle = title ? `${title} · swisscoverage` : "swisscoverage";
// The path as the browser sent it: Astro.url is decoded, which would change
// the identifier in a station's address (see stationIdFromPath).
const path = new URL(Astro.request.url).pathname;
const alternates = !error && isLocale(path.split("/")[1]) ? locales : [];
const linkTo = (other: Locale) =>
  error ? `/${other}/` : localizedPath(path, other);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t("site.description")} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {alternates.map((other) => (
      <link rel="alternate" hreflang={other} href={localizedPath(path, other)} />
    ))}
  </head>
  <body
    class:list={[
      "flex min-h-dvh flex-col bg-background text-foreground",
      fullscreen && "h-dvh overflow-hidden",
    ]}
  >
    {fullscreen ? (
      <div class="pointer-events-none absolute top-3 right-3 z-[4]">
        <SiteNav
          locale={locale}
          path={path}
          linkTo={linkTo}
          current={!error}
          keepView
          hideCurrent
        />
      </div>
    ) : (
      <header
        class:list={[
          "flex flex-wrap items-center justify-between gap-2 p-3",
          overlay && "pointer-events-none absolute inset-x-0 top-0 z-[4]",
        ]}
      >
        <a
          class="pointer-events-auto flex min-h-12 items-center gap-2.5 rounded-full bg-surface pr-5 pl-2.5 font-extrabold text-foreground no-underline shadow-float"
          href={`/${locale}/`}
        >
          <Logo />
          swisscoverage
        </a>
        <SiteNav locale={locale} path={path} linkTo={linkTo} current={!error} />
      </header>
    )}
    <main class:list={["w-full flex-1", fullscreen && "relative"]}>
      <slot />
    </main>
    {!fullscreen && (
      <footer
        class="mx-auto flex w-full max-w-[70rem] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-8 text-[0.8125rem] text-muted"
      >
        <p>{t("footer.source")}</p>
        <p>
          <a href="https://github.com/mathieumaf/swisscoverage">{t("footer.code")}</a>{" · "}{t("footer.licence")}
        </p>
      </footer>
    )}
    <script>
      // The menu of languages closes when the visitor clicks elsewhere or
      // presses Escape, as other menus do.
      const menus = document.querySelectorAll<HTMLDetailsElement>(
        "details.language-menu",
      );
      document.addEventListener("click", (event) => {
        for (const menu of menus) {
          if (menu.open && !menu.contains(event.target as Node)) {
            menu.open = false;
          }
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") {
          return;
        }
        for (const menu of menus) {
          if (menu.open) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
          }
        }
      });
    </script>
  </body>
</html>
