---
// The site's mark: a site on the map and the waves it sends, a point with two
// halos. public/favicon.svg draws the same in fixed colours.
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  width={size}
  height={size}
  aria-hidden="true"
  class="flex-none"
>
  <circle cx="50" cy="50" r="48" class="fill-accent" opacity="0.16"></circle>
  <circle cx="50" cy="50" r="34" class="fill-accent" opacity="0.34"></circle>
  <circle cx="50" cy="50" r="20" class="fill-accent"></circle>
  <circle cx="50" cy="50" r="7" class="fill-surface"></circle>
</svg>
