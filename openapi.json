    "/v1/stations/search": {
      "get": {
        "description": "The sites of the latest snapshot inside a rectangle, given by `bbox`, or within `radius` metres of a point, given by `lat` and `lon`. Exactly one of the two is required. Each filter accepts several values, separated by commas, and keeps the sites that have one of them; filters combine with each other. Results are ordered by label and position, or nearest first around a point.",
        "operationId": "search-stations",
        "parameters": [
          {
            "description": "A rectangle in WGS84, as west,south,east,north in degrees: the longitude of its west edge, the latitude of its south edge, and so on. Edges are included.",
            "explode": false,
            "in": "query",
            "name": "bbox",
            "schema": {
              "description": "A rectangle in WGS84, as west,south,east,north in degrees: the longitude of its west edge, the latitude of its south edge, and so on. Edges are included.",
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            }
          },
          {
            "description": "The latitude of the point to search around, in WGS84 degrees. Requires lon.",
            "explode": false,
            "in": "query",
            "name": "lat",
            "schema": {
              "description": "The latitude of the point to search around, in WGS84 degrees. Requires lon.",
              "format": "double",
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          },
          {
            "description": "The longitude of the point to search around, in WGS84 degrees. Requires lat.",
            "explode": false,
            "in": "query",
            "name": "lon",
            "schema": {
              "description": "The longitude of the point to search around, in WGS84 degrees. Requires lat.",
              "format": "double",
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            }
          },
          {
            "description": "Around a point: the distance to search within, in metres.",
            "explode": false,
            "in": "query",
            "name": "radius",
            "schema": {
              "default": 1000,
              "description": "Around a point: the distance to search within, in metres.",
              "format": "double",
              "maximum": 50000,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Keeps the sites run by one of these operators.",
            "explode": false,
            "in": "query",
            "name": "operator",
            "schema": {
              "description": "Keeps the sites run by one of these operators.",
              "items": {
                "description": "Who runs the station. `other` groups the stations published without a known operator, such as foreign stations near the border.",
                "enum": [
                  "swisscom",
                  "sunrise",
                  "salt",
                  "sbb",
                  "other"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            }
          },
          {
            "description": "Keeps the sites of one of these kinds.",
            "explode": false,
            "in": "query",
            "name": "kind",
            "schema": {
              "description": "Keeps the sites of one of these kinds.",
              "items": {
                "description": "The type of site: outdoor above 6 W ERP, outdoor up to 6 W ERP, indoor up to 6 W ERP, in a tunnel, temporary, or not published.",
                "enum": [
                  "outdoor",
                  "outdoor_low_power",
                  "indoor",
                  "tunnel",
                  "temporary",
                  "unknown"
                ],
                "type": "string"
              },
              "maxItems": 6,
              "type": "array"
            }
          },
          {
            "description": "Keeps the sites of one of these power classes.",
            "explode": false,
            "in": "query",
            "name": "powerClass",
            "schema": {
              "description": "Keeps the sites of one of these power classes.",
              "items": {
                "description": "The class of ERP90, the highest cumulated power radiated in a 90° sector, as OFCOM publishes it.",
                "enum": [
                  "very_low",
                  "low",
                  "medium",
                  "high",
                  "unknown"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "type": "array"
            }
          },
          {
            "description": "Keeps the sites that have one of these technologies.",
            "explode": false,
            "in": "query",
            "name": "technology",
            "schema": {
              "description": "Keeps the sites that have one of these technologies.",
              "items": {
                "description": "A mobile network generation.",
                "enum": [
                  "2G",
                  "3G",
                  "4G",
                  "5G"
                ],
                "type": "string"
              },
              "maxItems": 4,
              "type": "array"
            }
          },
          {
            "description": "The most items to return.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "description": "The most items to return.",
              "format": "int64",
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "How many items to skip, for the next pages.",
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "description": "How many items to skip, for the next pages.",
              "format": "int64",
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The ETag of a response already held.",
            "in": "header",
            "name": "If-None-Match",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "description": "The response may be reused for five minutes: the data changes once a day.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Changes exactly when the response does. Send it back in If-None-Match to get 304 when nothing changed.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the response named by If-None-Match is still the current one."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Stations in a rectangle or around a point",
        "tags": [
          "Stations"
        ]
      }
    },
    "/v1/stations/{id}": {
      "get": {
        "description": "A site, published today or in the past, with what each snapshot published about it: one period for each stretch of time during which nothing changed, the latest first.",
        "operationId": "get-station",
        "parameters": [
          {
            "description": "The station's identifier, as east_north_label, such as 2683000_1247000_Sunrise ZH601-1, percent-encoded in the path.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The station's identifier, as east_north_label, such as 2683000_1247000_Sunrise ZH601-1, percent-encoded in the path.",
              "maxLength": 200,
              "pattern": "^-?[0-9]+(\\.[0-9]+)?_-?[0-9]+(\\.[0-9]+)?_.+$",
              "type": "string"
            }
          },
          {
            "description": "The most items to return.",
            "explode": false,
            "in": "query",
