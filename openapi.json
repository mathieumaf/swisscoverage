          },
          "type": {
            "enum": [
              "FeatureCollection"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "attribution",
          "snapshot",
          "features"
        ],
        "type": "object"
      },
      "StationCounts": {
        "additionalProperties": false,
        "properties": {
