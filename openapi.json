            "description": "The credit OFCOM's terms require.",
            "type": "string"
          },
          "kinds": {
            "items": {
              "$ref": "#/components/schemas/KindCount"
            },
            "type": "array"
          },
          "operators": {
            "items": {
              "$ref": "#/components/schemas/OperatorCount"
            },
            "type": "array"
          },
          "powerClasses": {
            "items": {
              "$ref": "#/components/schemas/PowerClassCount"
            },
            "type": "array"
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot",
            "description": "The snapshot these counts come from."
          },
          "stations": {
            "description": "How many sites the snapshot publishes.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "technologies": {
            "items": {
              "$ref": "#/components/schemas/TechnologyCount"
            },
            "type": "array"
          }
        },
        "required": [
          "attribution",
          "snapshot",
          "stations",
          "operators",
          "kinds",
          "powerClasses",
          "technologies"
        ],
        "type": "object"
      },
      "StationFeature": {
        "additionalProperties": false,
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/PointGeometry"
          },
          "id": {
            "description": "The station's identifier, as in the station's own response.",
            "type": "string"
          },
          "properties": {
            "$ref": "#/components/schemas/StationProperties"
          },
          "type": {
