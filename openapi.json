            "type": "string"
          },
          "offset": {
            "format": "int64",
            "type": "integer"
          },
          "operator": {
            "description": "Who runs the station. `other` groups the stations published without a known operator, such as foreign stations near the border.",
            "enum": [
              "swisscom",
              "sunrise",
              "salt",
              "sbb",
              "other"
            ],
            "type": "string"
          },
          "periods": {
            "description": "What was published of the site, period by period, the latest first.",
            "items": {
              "$ref": "#/components/schemas/Period"
            },
            "type": "array"
          },
          "position": {
            "$ref": "#/components/schemas/Position",
            "description": "The same position in WGS84, computed with the rigorous transformation, to 7 decimals."
