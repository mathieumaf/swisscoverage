{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "KindCount": {
        "additionalProperties": false,
        "properties": {
          "stations": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "value": {
            "description": "The type of site: outdoor above 6 W ERP, outdoor up to 6 W ERP, indoor up to 6 W ERP, in a tunnel, temporary, or not published.",
            "enum": [
              "outdoor",
              "outdoor_low_power",
              "indoor",
              "tunnel",
              "temporary",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "value",
          "stations"
        ],
        "type": "object"
      },
      "LV95": {
        "additionalProperties": false,
        "properties": {
          "east": {
            "description": "Easting in LV95 (EPSG:2056), in metres.",
            "format": "double",
            "type": "number"
          },
          "north": {
            "description": "Northing in LV95 (EPSG:2056), in metres.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "east",
          "north"
        ],
        "type": "object"
      },
      "OperatorCount": {
        "additionalProperties": false,
        "properties": {
          "stations": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "value": {
            "description": "Who runs the station. `other` groups the stations published without a known operator, such as foreign stations near the border.",
            "enum": [
              "swisscom",
              "sunrise",
              "salt",
              "sbb",
              "other"
            ],
            "type": "string"
          }
        },
        "required": [
          "value",
          "stations"
        ],
        "type": "object"
      },
      "Period": {
        "additionalProperties": false,
        "properties": {
          "adaptive": {
            "description": "Whether at least part of the site runs adaptive antennas. Null when the file says something that is not recognised.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "from": {
            "description": "The publication time of the snapshot that first showed these values.",
            "format": "date-time",
            "type": "string"
          },
          "installationLimitValue": {
            "description": "The installation limit value, in V/m. Null when absent or left blank.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "kind": {
            "description": "The type of site: outdoor above 6 W ERP, outdoor up to 6 W ERP, indoor up to 6 W ERP, in a tunnel, temporary, or not published.",
            "enum": [
              "outdoor",
              "outdoor_low_power",
              "indoor",
              "tunnel",
              "temporary",
              "unknown"
            ],
            "type": "string"
          },
          "permit": {
            "$ref": "#/components/schemas/Permit",
            "description": "Null when OFCOM publishes no permit information."
          },
          "powerClass": {
            "description": "The class of ERP90, the highest cumulated power radiated in a 90° sector, as OFCOM publishes it.",
            "enum": [
              "very_low",
              "low",
              "medium",
              "high",
              "unknown"
            ],
            "type": "string"
          },
          "technologies": {
            "description": "In generation order. Empty when the file lists none that is recognised.",
            "items": {
              "description": "A mobile network generation.",
              "enum": [
                "2G",
                "3G",
                "4G",
                "5G"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "to": {
            "description": "The publication time of the first snapshot that no longer did. Null while they are still published.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "kind",
          "powerClass",
          "technologies",
          "adaptive",
          "permit",
          "installationLimitValue"
        ],
        "type": "object"
      },
      "Permit": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "description": "The date of the site data sheet. Absent for an exemption, and when the published date is not a day that exists.",
            "format": "date",
            "type": "string"
          },
          "type": {
            "description": "`site_data_sheet`: a site data sheet was filed. `exempt`: the site is exempt from the precautionary emission limit (NISV Annex 1 No. 64).",
            "enum": [
              "site_data_sheet",
              "exempt"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": [
          "object",
          "null"
        ]
      },
      "PointGeometry": {
        "additionalProperties": false,
        "properties": {
          "coordinates": {
            "description": "Longitude and latitude in WGS84, in degrees, to 7 decimals.",
            "items": {
              "format": "double",
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "type": {
            "enum": [
              "Point"
            ],
            "type": "string"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "type": "object"
      },
      "Position": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "description": "Latitude in WGS84, in degrees.",
            "format": "double",
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "lon": {
            "description": "Longitude in WGS84, in degrees.",
            "format": "double",
            "maximum": 180,
            "minimum": -180,
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "type": "object"
      },
      "PowerClassCount": {
        "additionalProperties": false,
        "properties": {
          "stations": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "value": {
            "description": "The class of ERP90, the highest cumulated power radiated in a 90° sector, as OFCOM publishes it.",
            "enum": [
              "very_low",
              "low",
              "medium",
              "high",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "value",
          "stations"
        ],
        "type": "object"
      },
      "PublishedStation": {
        "additionalProperties": false,
