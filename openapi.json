          "stations": {
            "items": {
              "$ref": "#/components/schemas/PublishedStation"
            },
            "type": "array"
          },
          "total": {
            "description": "How many stations the search matched, on every page.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "attribution",
          "snapshot",
          "stations",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "Snapshot": {
        "additionalProperties": false,
        "properties": {
          "publishedAt": {
            "description": "When OFCOM published the file. It identifies the snapshot.",
            "format": "date-time",
            "type": "string"
          },
          "sha256": {
            "description": "The SHA-256 of the file as published, in hexadecimal.",
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sites": {
            "description": "The number of sites in the file.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "publishedAt",
          "sha256",
          "sites"
        ],
        "type": "object"
      },
