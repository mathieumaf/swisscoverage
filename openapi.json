  "info": {
    "description": "The mobile network sites of Switzerland that OFCOM publishes, as they are today and as they were since the archive began. Read-only, and free to use. Source: Federal Office of Communications OFCOM, whose terms ask that the source be given: https://opendata.swiss/en/terms-of-use/#terms_by. Every response may be cached: the data changes once a day.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "AGPL-3.0-only, for the code; the data keeps the terms of its source"
    },
    "title": "swisscoverage",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/snapshots": {
      "get": {
        "description": "The files published by OFCOM that the data comes from, one per day since the archive began, the newest first.",
        "operationId": "list-snapshots",
        "parameters": [
          {
            "description": "The most items to return.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 100,
              "description": "The most items to return.",
              "format": "int64",
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "How many items to skip, for the next pages.",
            "explode": false,
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "description": "How many items to skip, for the next pages.",
              "format": "int64",
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "description": "The ETag of a response already held.",
            "in": "header",
            "name": "If-None-Match",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotList"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "description": "The response may be reused for five minutes: the data changes once a day.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Changes exactly when the response does. Send it back in If-None-Match to get 304 when nothing changed.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the response named by If-None-Match is still the current one."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "The snapshots",
        "tags": [
          "Snapshots"
        ]
      }
    },
