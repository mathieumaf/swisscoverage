              "null"
            ]
          },
          "code": {
            "description": "The label without the operator's name, such as \"ZH601-1\".",
            "type": "string"
          },
          "distance": {
            "description": "Around a point only: the distance from it, in metres, on the ellipsoid.",
            "format": "double",
            "type": "number"
          },
          "firstSeen": {
            "description": "The publication time of the first snapshot that showed the site.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The site's identifier: its LV95 position and its label, as east_north_label. OFCOM publishes no identifier, and a label alone is not unique.",
            "type": "string"
          },
          "installationLimitValue": {
            "description": "The installation limit value, in V/m. Null when absent or left blank.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "kind": {
            "description": "The type of site: outdoor above 6 W ERP, outdoor up to 6 W ERP, indoor up to 6 W ERP, in a tunnel, temporary, or not published.",
            "enum": [
              "outdoor",
              "outdoor_low_power",
              "indoor",
              "tunnel",
              "temporary",
              "unknown"
            ],
            "type": "string"
          },
          "lv95": {
            "$ref": "#/components/schemas/LV95",
            "description": "The position as published."
          },
          "name": {
            "description": "The station label exactly as published, such as \"Sunrise ZH601-1\".",
            "type": "string"
          },
          "operator": {
            "description": "Who runs the station. `other` groups the stations published without a known operator, such as foreign stations near the border.",
            "enum": [
              "swisscom",
              "sunrise",
              "salt",
              "sbb",
              "other"
            ],
            "type": "string"
          },
          "permit": {
            "$ref": "#/components/schemas/Permit",
            "description": "Null when OFCOM publishes no permit information."
          },
          "position": {
            "$ref": "#/components/schemas/Position",
            "description": "The same position in WGS84, computed with the rigorous transformation, to 7 decimals."
          },
          "powerClass": {
            "description": "The class of ERP90, the highest cumulated power radiated in a 90° sector, as OFCOM publishes it.",
            "enum": [
              "very_low",
              "low",
              "medium",
              "high",
              "unknown"
            ],
            "type": "string"
          },
          "technologies": {
            "description": "In generation order. Empty when the file lists none that is recognised.",
            "items": {
              "description": "A mobile network generation.",
              "enum": [
                "2G",
                "3G",
                "4G",
                "5G"
              ],
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "operator",
          "code",
          "lv95",
          "position",
          "firstSeen",
          "kind",
          "powerClass",
          "technologies",
          "adaptive",
          "permit",
          "installationLimitValue"
        ],
        "type": "object"
      },
      "SearchResult": {
        "additionalProperties": false,
        "properties": {
          "attribution": {
            "description": "The credit OFCOM's terms require.",
            "type": "string"
          },
          "limit": {
            "format": "int64",
            "type": "integer"
